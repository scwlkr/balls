          "role",
          "joinedAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "joinedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NodeListResponse": {
        "required": [
          "circleId",
          "nodes"
        ],
        "type": "object",
        "properties": {
          "circleId": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CircleNodeResponse"
            }
          }
        }
      },
      "NodeResponse": {
        "required": [
          "id",
          "displayName",
          "createdAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },

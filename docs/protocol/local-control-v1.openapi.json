  "components": {
    "schemas": {
      "BrowserSessionResponse": {
        "required": [
          "antiforgeryToken",
          "expiresAtUtc"
        ],
        "type": "object",
        "properties": {
          "antiforgeryToken": {
            "type": "string"
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CircleDetailsResponse": {
        "required": [
          "circle",
          "members",
          "nodes"
        ],
        "type": "object",
        "properties": {
          "circle": {
            "$ref": "#/components/schemas/CircleResponse"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberResponse"
            }
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CircleNodeResponse"
            }
          }
        }
      },
      "CircleListResponse": {
        "required": [
          "circles"
        ],
        "type": "object",
        "properties": {
          "circles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CircleResponse"
            }
          }
        }
      },
      "CircleMessageListResponse": {
        "required": [
          "circleId",
          "messages"
        ],
        "type": "object",
        "properties": {
          "circleId": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CircleMessageResponse"
            }
          }
        }
      },
      "CircleMessageResponse": {
        "required": [
          "id",
          "circleId",
          "sequence",
          "authorMemberId",
          "authorNodeId",
          "text",
          "authoredAtUtc",
          "acceptedAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "circleId": {
            "type": "string"
          },
          "sequence": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "authorMemberId": {
            "type": "string"
          },
          "authorNodeId": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "authoredAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "acceptedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CircleNodeResponse": {
        "required": [
          "id",
          "displayName",
          "joinedAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "joinedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CircleResponse": {
        "required": [
          "id",
          "name",
          "createdAtUtc",
          "memberCount",
          "nodeCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "memberCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "nodeCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateCircleRequest": {
        "required": [
          "requestId",
          "name",
          "ownerDisplayName"
        ],
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ownerDisplayName": {
            "type": "string"
          }
        }
      },
      "CreateInvitationRequest": {
        "required": [
          "validForMinutes"
        ],
        "type": "object",
        "properties": {
          "validForMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateInvitationResponse": {
        "required": [
          "circleId",
          "invitationId",
          "expiresAtUtc",
          "package"
        ],
        "type": "object",
        "properties": {
          "circleId": {
            "type": "string"
          },
          "invitationId": {
            "type": "string"
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "package": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ExchangeBrowserSessionRequest": {
        "required": [
          "capability"
        ],
        "type": "object",
        "properties": {
          "capability": {
            "type": "string"
          }
        }
      },
      "JoinCircleRequest": {
        "required": [
          "package",
          "endpoint",
          "memberDisplayName"
        ],
        "type": "object",
        "properties": {
          "package": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "memberDisplayName": {
            "type": "string"
          }
        }
      },
      "LaunchBrowserResponse": {
        "required": [
          "url",
          "expiresAtUtc"

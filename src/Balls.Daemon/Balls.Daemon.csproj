<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>ballsd</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Balls.Core\Balls.Core.csproj" />
    <ProjectReference Include="..\Balls.Host\Balls.Host.csproj" />
    <ProjectReference Include="..\Balls.Platform\Balls.Platform.csproj" />
    <ProjectReference Include="..\Balls.Protocol\Balls.Protocol.csproj" />
    <ProjectReference Include="..\Balls.Storage.Sqlite\Balls.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\Balls.Transport.Lan\Balls.Transport.Lan.csproj" />
    <ProjectReference Include="..\Balls.Windows.Helper\Balls.Windows.Helper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <Target Name="BuildBrowserBundle" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec
      Command="pnpm web:build"
      WorkingDirectory="$(MSBuildProjectDirectory)\..\.." />
    <ItemGroup>
      <_BrowserBundle Include="$(MSBuildProjectDirectory)\..\..\web\Balls.Web\dist\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_BrowserBundle)"
      DestinationFiles="@(_BrowserBundle->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishBrowserBundle" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="BuildBrowserBundle">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_BrowserBundle)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="CopyWindowsCircleFilesHelper" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_WindowsCircleFilesHelper Include="$(MSBuildProjectDirectory)\..\Balls.Windows.Helper\bin\$(Configuration)\net10.0\balls-windows-helper*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WindowsCircleFilesHelper)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target
    Name="PublishWindowsCircleFilesHelper"
    AfterTargets="Publish"
    Condition="$([MSBuild]::IsOSPlatform('Windows')) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">
    <PropertyGroup>
      <_WindowsCircleFilesHelperPublishDir Condition="'$(RuntimeIdentifier)' == ''">$(MSBuildProjectDirectory)\..\Balls.Windows.Helper\bin\$(Configuration)\net10.0\</_WindowsCircleFilesHelperPublishDir>
      <_WindowsCircleFilesHelperPublishDir Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)\..\Balls.Windows.Helper\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\</_WindowsCircleFilesHelperPublishDir>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(_WindowsCircleFilesHelperPublishDir)balls-windows-helper.exe') Or !Exists('$(_WindowsCircleFilesHelperPublishDir)balls-windows-helper.dll') Or !Exists('$(_WindowsCircleFilesHelperPublishDir)balls-windows-helper.deps.json') Or !Exists('$(_WindowsCircleFilesHelperPublishDir)balls-windows-helper.runtimeconfig.json')"
      Text="The complete Windows Circle Files helper was not built for publishing." />
    <ItemGroup>
      <_WindowsCircleFilesHelperPublish Include="$(_WindowsCircleFilesHelperPublishDir)balls-windows-helper.exe" />
      <_WindowsCircleFilesHelperPublish Include="$(_WindowsCircleFilesHelperPublishDir)balls-windows-helper.dll" />
      <_WindowsCircleFilesHelperPublish Include="$(_WindowsCircleFilesHelperPublishDir)balls-windows-helper.deps.json" />
      <_WindowsCircleFilesHelperPublish Include="$(_WindowsCircleFilesHelperPublishDir)balls-windows-helper.runtimeconfig.json" />
      <_WindowsCircleFilesHelperPublish Include="$(_WindowsCircleFilesHelperPublishDir)balls-windows-helper.pdb" Condition="Exists('$(_WindowsCircleFilesHelperPublishDir)balls-windows-helper.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WindowsCircleFilesHelperPublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Error
      Condition="!Exists('$(PublishDir)balls-windows-helper.dll')"
      Text="The published Windows Circle Files helper is incomplete." />
  </Target>
</Project>

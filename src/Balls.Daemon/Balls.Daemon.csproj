<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>ballsd</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Balls.Core\Balls.Core.csproj" />
    <ProjectReference Include="..\Balls.Host\Balls.Host.csproj" />
    <ProjectReference Include="..\Balls.Platform\Balls.Platform.csproj" />
    <ProjectReference Include="..\Balls.Protocol\Balls.Protocol.csproj" />
    <ProjectReference Include="..\Balls.Storage.Sqlite\Balls.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\Balls.Transport.Lan\Balls.Transport.Lan.csproj" />
    <ProjectReference Include="..\Balls.Windows.Helper\Balls.Windows.Helper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <Target Name="BuildBrowserBundle" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec
      Command="pnpm web:build"
      WorkingDirectory="$(MSBuildProjectDirectory)\..\.." />
    <ItemGroup>
      <_BrowserBundle Include="$(MSBuildProjectDirectory)\..\..\web\Balls.Web\dist\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_BrowserBundle)"
      DestinationFiles="@(_BrowserBundle->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishBrowserBundle" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="BuildBrowserBundle">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_BrowserBundle)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="CopyWindowsCircleFilesHelper" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_WindowsCircleFilesHelper Include="$(MSBuildProjectDirectory)\..\Balls.Windows.Helper\bin\$(Configuration)\net10.0\balls-windows-helper*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WindowsCircleFilesHelper)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishWindowsCircleFilesHelper" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_WindowsCircleFilesHelperPublish Include="$(MSBuildProjectDirectory)\..\Balls.Windows.Helper\bin\$(Configuration)\net10.0\balls-windows-helper*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WindowsCircleFilesHelperPublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
